-- eBay API Client Tests
-- Run: quill test examples/ebay/test.quill

-- ─── Helper Tests ───

to mock_build_query params:
  parts are []
  for each entry in entries(params):
    key is entry[0]
    val is entry[1]
    if val is not nothing and val is not "":
      push(parts, "{encodeURL(key)}={encodeURL(val)}")
  if length(parts) is 0:
    give back ""
  give back "?" + join(parts, "&")

test "build_query with empty params returns empty string":
  result is mock_build_query({})
  expect result is ""

test "build_query with one param":
  result is mock_build_query({q: "laptop"})
  expect contains(result, "q=laptop") is yes
  expect startsWith(result, "?") is yes

test "build_query with multiple params":
  result is mock_build_query({q: "laptop", limit: "5"})
  expect startsWith(result, "?") is yes
  expect contains(result, "q=laptop") is yes
  expect contains(result, "limit=5") is yes

test "build_query skips nothing values":
  result is mock_build_query({q: "test", empty: nothing, also_empty: ""})
  expect contains(result, "q=test") is yes
  expect contains(result, "empty") is no
  expect contains(result, "also_empty") is no

test "build_query encodes special characters":
  result is mock_build_query({q: "red shoes"})
  expect contains(result, "red%20shoes") is yes

-- ─── Format Price Tests ───

to mock_format_price price_obj:
  if price_obj is nothing:
    give back "N/A"
  give back "{price_obj.currency} {price_obj.value}"

test "format_price with valid price":
  result is mock_format_price({currency: "USD", value: "29.99"})
  expect result is "USD 29.99"

test "format_price with nothing":
  result is mock_format_price(nothing)
  expect result is "N/A"

test "format_price with GBP":
  result is mock_format_price({currency: "GBP", value: "15.00"})
  expect result is "GBP 15.00"

-- ─── Configuration Tests ───

test "sandbox URL is correct":
  url is "https://api.sandbox.ebay.com"
  expect contains(url, "sandbox") is yes

test "production URL is correct":
  url is "https://api.ebay.com"
  expect contains(url, "sandbox") is no

test "auth URL uses correct path":
  auth is "https://api.sandbox.ebay.com/identity/v1/oauth2/token"
  expect endsWith(auth, "/token") is yes
  expect contains(auth, "identity") is yes
  expect contains(auth, "oauth2") is yes

-- ─── API Path Tests ───

to browse_search_path query limit:
  params is {q: query, limit: "{limit}"}
  qs is mock_build_query(params)
  give back "/buy/browse/v1/item_summary/search{qs}"

to item_path item_id:
  give back "/buy/browse/v1/item/{encodeURL(item_id)}"

to inventory_path sku:
  give back "/sell/inventory/v1/inventory_item/{encodeURL(sku)}"

to order_path order_id:
  give back "/sell/fulfillment/v1/order/{order_id}"

to taxonomy_tree_path tree_id:
  give back "/commerce/taxonomy/v1/category_tree/{tree_id}"

test "browse search path is correct":
  path is browse_search_path("laptop", 10)
  expect contains(path, "/buy/browse/v1/item_summary/search") is yes
  expect contains(path, "q=laptop") is yes
  expect contains(path, "limit=10") is yes

test "item path encodes item ID":
  path is item_path("v1|123456|0")
  expect contains(path, "/buy/browse/v1/item/") is yes

test "inventory path is correct":
  path is inventory_path("SKU-001")
  expect contains(path, "/sell/inventory/v1/inventory_item/") is yes
  expect contains(path, "SKU-001") is yes

test "order path is correct":
  path is order_path("12-34567-89012")
  expect path is "/sell/fulfillment/v1/order/12-34567-89012"

test "taxonomy tree path is correct":
  path is taxonomy_tree_path("0")
  expect path is "/commerce/taxonomy/v1/category_tree/0"

-- ─── Base64 Credentials Tests ───

test "credentials encode to base64":
  credentials is "test_id:test_secret"
  encoded is encodeBase64(credentials)
  decoded is decodeBase64(encoded)
  expect decoded is credentials

test "empty credentials encode correctly":
  encoded is encodeBase64(":")
  decoded is decodeBase64(encoded)
  expect decoded is ":"

-- ─── Mock API Response Tests ───

to mock_search_response:
  give back {
    total: 3,
    itemSummaries: [
      {title: "Laptop Pro 15", price: {currency: "USD", value: "999.99"}, condition: "New"},
      {title: "Laptop Air 13", price: {currency: "USD", value: "799.00"}, condition: "New"},
      {title: "Used Laptop", price: {currency: "USD", value: "349.50"}, condition: "Used"}
    ]
  }

to mock_inventory_response:
  give back {
    inventoryItems: [
      {sku: "SKU-001", product: {title: "Widget A"}, availability: {shipToLocationAvailability: {quantity: 50}}},
      {sku: "SKU-002", product: {title: "Widget B"}, availability: {shipToLocationAvailability: {quantity: 25}}}
    ],
    total: 2
  }

test "search response has expected structure":
  response is mock_search_response()
  expect response.total is 3
  expect length(response.itemSummaries) is 3

test "search results have required fields":
  response is mock_search_response()
  for each item in response.itemSummaries:
    expect hasKey(item, "title") is yes
    expect hasKey(item, "price") is yes
    expect hasKey(item.price, "currency") is yes
    expect hasKey(item.price, "value") is yes

test "can filter search results by condition":
  response is mock_search_response()
  new_items is filter(response.itemSummaries, with i: i.condition is "New")
  expect length(new_items) is 2

test "can find cheapest item":
  response is mock_search_response()
  prices is map_list(response.itemSummaries, with i: toNumber(i.price.value))
  sorted is sort(prices)
  expect sorted[0] is 349.5

test "inventory response has items":
  response is mock_inventory_response()
  expect response.total is 2
  expect length(response.inventoryItems) is 2

test "inventory items have SKU":
  response is mock_inventory_response()
  for each item in response.inventoryItems:
    expect hasKey(item, "sku") is yes
    expect startsWith(item.sku, "SKU-") is yes

test "can calculate total inventory":
  response is mock_inventory_response()
  quantities is map_list(response.inventoryItems, with i: i.availability.shipToLocationAvailability.quantity)
  total_qty is sum(quantities)
  expect total_qty is 75

-- ─── Finding API Mock Tests ───

to mock_finding_response:
  give back {
    findItemsByKeywordsResponse: [{
      searchResult: [{
        count: "2",
        item: [
          {
            itemId: ["123456789"],
            title: ["eBay Finding Item 1"],
            sellingStatus: [{currentPrice: [{value: "19.99", currencyId: "USD"}]}]
          },
          {
            itemId: ["987654321"],
            title: ["eBay Finding Item 2"],
            sellingStatus: [{currentPrice: [{value: "39.99", currencyId: "USD"}]}]
          }
        ]
      }],
      paginationOutput: [{
        totalPages: ["1"],
        totalEntries: ["2"]
      }]
    }]
  }

test "finding response has search results":
  response is mock_finding_response()
  search is response.findItemsByKeywordsResponse[0].searchResult[0]
  expect search.count is "2"
  expect length(search.item) is 2

test "finding items have IDs and titles":
  response is mock_finding_response()
  items is response.findItemsByKeywordsResponse[0].searchResult[0].item
  for each item in items:
    expect length(item.itemId) is greater than 0
    expect length(item.title) is greater than 0

-- ─── Marketplace ID Tests ───

test "supported marketplace IDs":
  marketplaces are ["EBAY_US", "EBAY_GB", "EBAY_DE", "EBAY_AU", "EBAY_CA", "EBAY_FR"]
  expect includes(marketplaces, "EBAY_US") is yes
  expect includes(marketplaces, "EBAY_GB") is yes
  expect length(marketplaces) is 6

-- ─── JSON Serialization Tests ───

test "inventory item serializes correctly":
  item is {
    sku: "TEST-001",
    product: {
      title: "Test Product",
      description: "A test item"
    },
    availability: {
      shipToLocationAvailability: {
        quantity: 10
      }
    }
  }
  json is toJSON(item)
  parsed is parseJSON(json)
  expect parsed.sku is "TEST-001"
  expect parsed.product.title is "Test Product"
  expect parsed.availability.shipToLocationAvailability.quantity is 10

test "offer data serializes correctly":
  offer is {
    sku: "TEST-001",
    marketplaceId: "EBAY_US",
    format: "FIXED_PRICE",
    pricingSummary: {
      price: {
        currency: "USD",
        value: "29.99"
      }
    }
  }
  json is toJSON(offer)
  parsed is parseJSON(json)
  expect parsed.format is "FIXED_PRICE"
  expect parsed.pricingSummary.price.value is "29.99"
